# Cabeçalhos de segurança dos arquivos estáticos (páginas, JS, CSS).
# As respostas da API (/api/*) definem os próprios cabeçalhos em servidor/http.js.
# Doc: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'none'; media-src 'self' blob:; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), fullscreen=(self), encrypted-media=(), picture-in-picture=()

# Página do comprador: não vaza o endereço por Referer, não entra no Google, não fica em cache.
/comprador
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Arquivos com hash no nome: cache de 1 ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
